# Postgres (shared CPX42 — same instance can host this DB next to Postiz)
DATABASE_URL=postgres://clipper:clipper@localhost:5432/clipper

# Redis (BullMQ queue — separate from Postiz Redis to avoid key collisions)
REDIS_URL=redis://localhost:6380

# Firebase Admin — reuse ondadev-metrics SA so the allowlist is shared
# with the dashboard. Base64-encoded service-account JSON (same value
# as FIREBASE_ONDADEV_METRICS_KEY_B64 in onda-dev).
FIREBASE_ONDADEV_METRICS_KEY_B64=

# Firebase Web SDK (browser auth) — same project as ondadev-metrics
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cookie domain. Leave empty in dev. In prod set to ".ondadev.com" so a
# session minted by onda-dev is accepted here too.
APP_HOST=

# Postiz — self-hosted on the same CPX42
POSTIZ_API_URL=http://postiz:3000/api/public/v1
POSTIZ_API_KEY=

# Storage root for downloaded sources, stitched outputs, and CTA videos.
# In Docker this maps to a mounted volume.
STORAGE_ROOT=./storage

# Apify — used for the actual video download (bypasses YouTube bot
# detection via residential proxies, no cookie maintenance). Get a token
# at https://console.apify.com/settings/integrations.
APIFY_TOKEN=
# Override which actor and quality to use. Defaults are sensible.
#   APIFY_VIDEO_ACTOR=marielise.dev~youtube-video-downloader
#   APIFY_VIDEO_QUALITY=1080p

# Absolute paths to worker binaries. Set when PATH is unreliable (Windows
# dev shell) — leave empty in Docker, the image installs them on PATH.
YTDLP_PATH=
FFMPEG_PATH=
